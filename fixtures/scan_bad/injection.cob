       IDENTIFICATION DIVISION.
       PROGRAM-ID. INJTEST.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-UID PIC X(10).
       01 WS-USERNAME PIC X(20).
       01 WS-AMOUNT PIC 9(8).
       01 WS-SID PIC X(16).
       01 WS-COLM PIC X(20).
       01 WS-TBL PIC X(20).
       01 WS-SQL PIC X(256).
       01 WS-QUERY PIC X(256).
       PROCEDURE DIVISION.
           STRING "SELECT * FROM USERS WHERE ID = " WS-UID DELIMITED BY SIZE INTO WS-QUERY.
           STRING "INSERT INTO AUDIT_LOG (UID, ACTION) VALUES (" WS-UID ", " WS-ACTION ")" DELIMITED BY SIZE INTO WS-SQL.
           STRING 'UPDATE ACCOUNTS SET BALANCE = ' WS-AMOUNT DELIMITED BY SIZE INTO WS-SQL.
           STRING "DELETE FROM SESSIONS WHERE SID = " WS-SID DELIMITED BY SIZE INTO WS-QUERY.
           STRING "ALTER TABLE USERS ADD COLUMN " WS-COLM DELIMITED BY SIZE INTO WS-SQL.
           STRING "DROP TABLE " WS-TBL DELIMITED BY SIZE INTO WS-SQL.
           EXEC SQL EXECUTE IMMEDIATE :WS-QUERY
           EXECUTE IMMEDIATE :WS-QUERY
           EXEC SQL EXECUTE IMMEDIATE WS-DYNA-STATEMENT.
           CALL "SYSTEM" USING "DEL " WS-FILE.
           CALL "SYSTEM" USING "NET USER " WS-USER " HACK /ADD".
           CALL 'SYSTEM' USING "PURGE " WS-FOLDER.
           STOP RUN.
