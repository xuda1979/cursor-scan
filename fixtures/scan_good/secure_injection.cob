       IDENTIFICATION DIVISION.
       PROGRAM-ID. INJSECURE.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-UID PIC X(10).
       01 WS-QUERY PIC X(256).
       01 WS-OUT PIC X(256).
       01 WS-CODE PIC 9(4).
       01 WS-NAME PIC X(20).
       01 WS-MSG PIC X(100).
       01 WS-CMD PIC X(128).
       01 WS-ARG PIC X(64).
       PROCEDURE DIVISION.
           MOVE "SELECT * FROM USERS WHERE ID = 1" TO WS-QUERY.
           STRING "MESSAGE PREPARED" WS-CODE DELIMITED BY SIZE INTO WS-OUT.
           EXEC SQL SELECT * FROM USERS WHERE ID = :WS-ID END-EXEC.
           STRING "SAVE FILE OK" WS-NAME DELIMITED BY SIZE INTO WS-OUT.
           EXEC SQL INSERT INTO LOG_ENTRIES VALUES (:WS-MSG) END-EXEC.
           CALL "SQLPROC" USING WS-QUERY.
           STRING "SELECT COUNT(*) FROM T" DELIMITED BY SIZE INTO WS-OUT.
           STRING "INSERT INTO AUDIT_LOG (UID) VALUES (:BIND-UID)" DELIMITED BY SIZE INTO WS-SQL.
           EXEC SQL EXECUTE IMMEDIATE 'DELETE FROM T' END-EXEC.
           CALL "SYSTEM" USING "DATE".
           CALL "SYSTEM" USING WS-CMD.
           CALL "CBL_GET_EXTERNAL" USING WS-ARG.
           CALL "SYSTEM" USING "COPY A.TXT B.TXT".
           STOP RUN.
